{
  "name": "dtu-science-writer",
  "productName": "DTU Science Writer",
  "version": "0.9.3",
  "description": "WYSIWYG writing of scientific papers and proposals, with Typst layout and Word/PDF export",
  "main": "main/main.js",
  "author": "Peter Bøggild",
  "license": "MIT",
  "private": true,
  "build": {
    "appId": "dk.dtu.sciencewriter",
    "productName": "DTU Science Writer",
    "files": [
      "main/**",
      "renderer/**",
      "!renderer/bundle.js.map",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/typst-packages",
        "to": "typst-packages"
      },
      {
        "from": "assets/fonts",
        "to": "typst-fonts"
      },
      {
        "from": "vendor-bin/typst.exe",
        "to": "typst/typst.exe"
      }
    ],
    "fileAssociations": [
      {
        "ext": "dtusw",
        "name": "DTU Science Writer document",
        "icon": "assets/icon.png"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "DTUScienceWriter-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "DTUScienceWriter-${version}-setup.exe",
      "oneClick": true,
      "perMachine": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "asar": true
  }
}
